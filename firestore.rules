rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 데모/내부용 공개 규칙입니다. 운영 배포 전 반드시 강화하세요.
    // - settings/admin 비밀번호는 클라이언트에 그대로 노출되므로
    //   실제 운영 시에는 Cloud Functions 기반 인증으로 교체를 권장합니다.
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
